# Rename to .env and fill with your server-specific values
DISCORD_TOKEN=your_bot_token_here
STAFF_CHANNEL_ID=your_staff_channel_id_here
ONDUTY_ROLE_ID=your_on_duty_role_id_here
# Optional: comma-separated role IDs that count someone as a moderator
MODERATOR_ROLE_IDS=
# Optional: comma-separated role IDs allowed to toggle duty status
ALLOWED_TOGGLE_ROLE_IDS=